# ============================================
# Solana 链上自动交易机器人 - 环境配置
# 配置档位: 激进档 (钱包30 SOL, 最大敞口20 SOL)
# 计价模式: SOL本位 (盈亏/仓位用SOL, 代币体量指标用USD)
# ============================================

# ---------- 服务端口 ----------
DASHBOARD_PORT=3001
WEBHOOK_API_KEY=your-secret-api-key-change-this

# ---------- API Keys ----------
BIRDEYE_API_KEY=your_birdeye_api_key
HELIUS_API_KEY=your_helius_api_key
JUPITER_API_KEY=your_jupiter_api_key

# ---------- RPC 配置 ----------
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet.helius-rpc.com

# ---------- 钱包配置 ----------
WALLET_PRIVATE_KEY=your_base58_private_key

# ---------- 监控池配置 ----------
MAX_MONITORED_TOKENS=100
PROTECTION_PERIOD_MINUTES=60
COOLDOWN_PERIOD_HOURS=24

# ---------- 退出阈值 (USD - 代币体量指标使用美元标准) ----------
WARNING_FDV_USD=80000
WARNING_LP_USD=25000
FORCE_EXIT_FDV_USD=30000
FORCE_EXIT_LP_USD=10000

# ---------- 入池过滤阈值 (USD) ----------
MIN_LP_USD=10000
MIN_VOLUME_24H_USD=50000
MIN_HOLDERS=100
MAX_TOP10_PERCENT=30

# ---------- 交易配置 (SOL - 激进档) ----------
# 单币最大仓位
MAX_POSITION_SOL=1.5
# 总持仓上限
MAX_TOTAL_POSITION_SOL=20
# 同时持仓数上限
MAX_CONCURRENT_POSITIONS=10
# 默认买入金额
DEFAULT_BUY_AMOUNT_SOL=0.5
# 滑点(基点, 100 = 1%)
DEFAULT_SLIPPAGE_BPS=300
# 优先费(microLamports)
PRIORITY_FEE_MICROLAMPORTS=100000

# ---------- 风控参数 ----------
# 止损百分比 (相对入场价)
STOP_LOSS_PERCENT=25
# 时间止损(小时) - 持仓超过此时长且未盈利则清仓
TIME_STOP_LOSS_HOURS=10
# 第一止盈点 (TP1: +100% = 2x, 卖出50%)
TP1_PERCENT=100
TP1_SELL_RATIO=50
# 第二止盈点 (TP2: +200% = 3x, 100%清仓)
TP2_PERCENT=200
TP2_SELL_RATIO=100
# 量能反转触发的最小盈利门槛(%) - 低于此盈利不触发反转清仓
VOLUME_REVERSAL_PROFIT_THRESHOLD=25

# ---------- 信号触发参数 ----------
# 量能爆发倍数(相对1h均值)
VOLUME_BURST_MULTIPLIER=5
# 独立买家数倍数
UNIQUE_BUYERS_MULTIPLIER=3
# 买卖笔数比阈值
BUY_SELL_RATIO_THRESHOLD=2.5
# 新钱包占比阈值
NEW_WALLET_RATIO_THRESHOLD=0.5
# 买入信号最低触发分数 (0-100)
MIN_BUY_SIGNAL_SCORE=65

# ---------- 大单检测 (相对该币近期交易统计,无需SOL价格) ----------
# 大单倍数(相对1h平均单笔大小)
LARGE_SWAP_MULTIPLIER=5
# 大单兜底最小值(SOL) - 当数据不足时使用
LARGE_SWAP_MIN_SOL=3
# 大单卖出告警: 1分钟内累计大单卖出额占LP_SOL的最小比例
LARGE_SELL_LP_RATIO_THRESHOLD=0.05

# ---------- 系统配置 ----------
NODE_ENV=production
LOG_LEVEL=info
DB_PATH=./data/trading-bot.db
DRY_RUN=true

# ---------- 报告配置 ----------
DAILY_REPORT_HOUR=8
DAILY_REPORT_TIMEZONE=Asia/Shanghai
